# Shared AWS SSO profile for the di-claude sandbox.
#
# Non-secret values only: the SSO start URL and role identity.
# Credentials are fetched at runtime via the device flow and never
# stored in the kit.
#
# TODO before first use: replace sso_account_id and sso_role_name
# with the values from your AWS IAM Identity Center.
# sso_region matches the SSO portal region used by di-kit (the
# device/portal.sso hosts in spec.yaml's network allow list must match it).

[profile di]
region = eu-west-2
sso_start_url = https://uk-digital-identity.awsapps.com/start/
sso_region = eu-west-2
sso_account_id = REPLACE_WITH_ACCOUNT_ID
sso_role_name = REPLACE_WITH_ROLE_NAME
