{
  "rules": [
    {
      "capability": "shell",
      "match": [
        "aws configure *",
        "env*",
        "printenv*",
        "terraform apply*",
        "terraform destroy*"
      ],
      "effect": "deny"
    },
    {
      "capability": "shell",
      "match": [
        "curl",
        "wget"
      ],
      "effect": "ask"
    }
  ]
}
